@{
    ViewData["Title"] = "Maturity Calculator";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}
<link href="~/css/calculator.css" rel="stylesheet" />

<div class="military-grid">
    <div class="army-emblem">🏛️</div>
    <div class="floating-particles" id="particles"></div>

    <div class="container-fluid calculator-container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-12 col-lg-4 col-xl-4">
                <div class="calculator-body">
                    <div class="army-header">
                        <div class="army-title">🧮 MATURITY BENEFIT CALCULATOR</div>
                    </div>

                    <div id="loanForm">
                        <!-- Date fields container (initially hidden, will show on top after selection) -->
                        <div id="dateFieldsContainer" class="hidden">
                            <!-- Date Of Joining/Enrolment -->
                            <div class="input-section">
                                <div class="section-label">📅 Enrolment/Start Date of AGIF subscription</div>
                                <input type="text" class="form-control monthPicker" id="dateOfBirth" aria-label="Date of Birth" required placeholder="DD/MM/YYYY" autocomplete="off">
                            </div>

                            <!-- Date of Commission (Only for Officers) -->
                            <div class="input-section hidden" id="commissionDateSection">
                                <div class="section-label">🎖️ Date of Commission (If Applicable)</div>
                                <input type="text" class="form-control monthPicker" id="commissionDate" aria-label="Commission Date" placeholder="DD/MM/YYYY (Leave blank if not applicable)" autocomplete="off">
                            </div>

                            <!-- Till Date -->
                            <div class="input-section">
                                <div class="section-label">📊 Calculate Till Date</div>
                                <input type="date"
                                       id="tillDate"
                                       name="tillDate"
                                       class="form-control"
                                       disabled />
                            </div>

                            <!-- Calculate Button -->
                            <div class="input-section">
                                <button type="button" id="calculateButton" class="calculate-btn">
                                    Calculate Maturity
                                </button>
                            </div>
                        </div>

                        <!-- Rank Group Radio Buttons (initially shown, will move to bottom after selection) -->
                        <div class="input-section" id="rankGroupSection">
                            <div class="section-label">🎖️ Rank Group</div>
                            <div class="rank-selection">
                                <div class="rank-option">
                                    <input type="radio" id="officers" name="category" value="1" class="rank-radio">
                                    <label for="officers" class="rank-label officers">
                                        <div class="rank-icon">👨‍✈️</div>
                                        <div class="rank-title">OFFICERS</div>
                                        <div class="rank-description">Commissioned Officers</div>
                                    </label>
                                </div>
                                <div class="rank-option">
                                    <input type="radio" id="jco_or" name="category" value="2" class="rank-radio">
                                    <label for="jco_or" class="rank-label">
                                        <div class="rank-icon">🪖</div>
                                        <div class="rank-title">JCO/OR</div>
                                        <div class="rank-description">Junior Commissioned Officers<br>& Other Ranks</div>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Breakdown Table -->
                        <div class="input-section">
                            <div class="section-label">Breakdown of Current Monthly Subscription</div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-bordered align-middle mb-0 text-center text-white">
                                        <thead>
                                            <tr class="text-white">
                                                <th class="text-white">Category</th>
                                                <th class="text-white">Risk Element</th>
                                                <th class="text-white">Saving Element</th>
                                                <th class="text-white">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="text-white">Offrs</td>
                                                <td class="text-white">1500</td>
                                                <td class="text-white">11000</td>
                                                <td class="text-white">12500</td>
                                            </tr>
                                            <tr>
                                                <td class="text-white">JCOs/OR</td>
                                                <td class="text-white">800</td>
                                                <td class="text-white">6700</td>
                                                <td class="text-white">7500</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/devjs/MaturityCalculator.js"></script>